# Copy this file to .env (never commit .env) and fill it in.

# Web address of the portal; it must point to this server. Caddy gets the HTTPS certificate for it.
DOMAIN=portal.example.com

# Database password: a long random string of letters and numbers only (no symbols).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# First super user, created on the very first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# true = the admin must choose a new password at first sign-in
ADMIN_MUST_CHANGE=false

# Optional
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=14
SNAPSHOT_DAYS=60
BACKUP_KEEP_DAYS=30
